{
  "name": "pinia-logger",
  "version": "2.0.0",
  "description": "Console logger for Pinia actions and Pinia Colada queries and mutations",
  "keywords": [
    "console",
    "devtools",
    "logger",
    "nuxt",
    "pinia",
    "pinia-colada",
    "vue"
  ],
  "homepage": "https://github.com/cwdx/pinia-logger#readme",
  "bugs": "https://github.com/cwdx/pinia-logger/issues",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwdx/pinia-logger.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./colada": {
      "import": "./dist/colada.mjs",
      "require": "./dist/colada.cjs"
    },
    "./nuxt": "./dist/nuxt.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "check": "node tests/consumer.ts && NODE_ENV=production node tests/consumer.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build && bun run check"
  },
  "devDependencies": {
    "@nuxt/schema": "4.6.4",
    "@pinia/colada": "1.4.9",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pinia": "4.1.0",
    "tsdown": "^0.23.4",
    "typescript": "7.0.2",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "@pinia/colada": ">=0.12.0 <2",
    "pinia": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "vue": "^2.7.0 || ^3.2.0"
  },
  "peerDependenciesMeta": {
    "@pinia/colada": {
      "optional": true
    }
  }
}
